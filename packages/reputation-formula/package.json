{
  "name": "@pneuma/reputation-formula",
  "version": "0.1.0",
  "description": "Conviction-weighted reputation formula for Pneuma — pure TypeScript, zero deps, reproducible from any dApp without forking the frontend.",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./v1": {
      "types": "./dist/v1.d.ts",
      "default": "./dist/v1.js"
    },
    "./v2": {
      "types": "./dist/v2.d.ts",
      "default": "./dist/v2.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "pneuma",
    "reputation",
    "ethereum",
    "erc-8004",
    "erc-6551",
    "attestation"
  ],
  "license": "MIT"
}
