# ─── Anthropic ──────────────────────────────────────────────────────────
# 给 Claude SDK 的 API key（你已有）
ANTHROPIC_API_KEY=sk-ant-...

# ─── Pneuma 链上配置 ────────────────────────────────────────────────────
# 这些值跟 monorepo 根 .env.local 一致；为了独立运行也可以在这里覆盖
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_CHAIN_ID=5042002
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_SKILL_REGISTRY_ADDRESS=0x4Ab33E9417FCb0D51ef4F9e989057BaD97587a7f

# Service signer —— x402 settle 用，与 SkillRegistry 注册时的 owner 一致
# 演示用 deployer key；生产用独立 service key
DEPLOYER_PRIVATE_KEY=0x...

# ─── Skill ID（链上注册后回填）──────────────────────────────────────────
# pnpm register 跑完后会输出 5 个 skillId，分别填到下面对应的环境变量
SKILL_ID_PAPER_SUMMARY=0
SKILL_ID_CODE_REVIEW=0
SKILL_ID_BLOCK_EXPLAINER=0
SKILL_ID_CREATIVE_WRITE=0
SKILL_ID_QUICK_REASONING=0

# ─── 端口分配 ───────────────────────────────────────────────────────────
PORT_PAPER_SUMMARY=3101
PORT_CODE_REVIEW=3102
PORT_BLOCK_EXPLAINER=3103
PORT_CREATIVE_WRITE=3104
PORT_QUICK_REASONING=3105

# ─── 公网 endpoint（Cloudflare Tunnel 暴露后回填）─────────────────────
# 链上注册时 endpoint 字段用这些；本地 dev 时不需要
PUBLIC_HOST=skills.pneuma.local
