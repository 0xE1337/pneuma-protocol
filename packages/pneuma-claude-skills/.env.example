# ─── 不需要任何 LLM API key ──────────────────────────────────────────────
# Reasoning 由本地 `claude -p` 完成（你的 Claude Code 订阅）。
# spawn 子进程时自动读 OAuth keychain，零 API token 消费。
#
# 验证：终端跑 `claude --version` 能看到版本号即可。

# ─── 链上配置 ───────────────────────────────────────────────────────────
# 以下变量都从 monorepo 根 .env.local 自动继承（已有），通常**不用在这里覆盖**
# ARC_TESTNET_RPC_URL=...
# NEXT_PUBLIC_CHAIN_ID=5042002
# NEXT_PUBLIC_USDC_ADDRESS=...
# NEXT_PUBLIC_SKILL_REGISTRY_ADDRESS=...
# DEPLOYER_PRIVATE_KEY=...
# TEST_SELLER_PRIVATE_KEY=...

# ─── Skill ID（注册后回填）──────────────────────────────────────────────
# 跑完 `pnpm register` 后把它输出的 5 行复制贴到这里
SKILL_ID_PAPER_SUMMARY=0
SKILL_ID_CODE_REVIEW=0
SKILL_ID_BLOCK_EXPLAINER=0
SKILL_ID_CREATIVE_WRITE=0
SKILL_ID_QUICK_REASONING=0

# ─── 端口（每 skill 一个，可选覆盖）────────────────────────────────────
# 默认值在 script/start-all.mjs 里：3101-3105
# PORT_PAPER_SUMMARY=3101
# PORT_CODE_REVIEW=3102
# PORT_BLOCK_EXPLAINER=3103
# PORT_CREATIVE_WRITE=3104
# PORT_QUICK_REASONING=3105

# ─── 公网 endpoint（Cloudflare Tunnel 暴露后回填，注册时用）─────────
# PUBLIC_BASE_URL=https://skills.pneuma.dev
