{
  "name": "@pneuma/claude-skills",
  "version": "0.1.0",
  "description": "5 sovereign-agent skill servers backed by the demonstrator's local `claude` CLI (Claude Code subscription). No Anthropic API key, no per-token billing.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "start:all": "node script/start-all.mjs",
    "build": "tsc",
    "register": "tsx script/register-all.ts",
    "register:tunnel": "tsx script/register-tunnel.ts",
    "tunnels:up": "node script/start-tunnels.mjs",
    "register:tunnels": "tsx script/register-tunnels.ts",
    "deactivate:old": "tsx script/deactivate-old.ts",
    "seed-traffic": "tsx script/seed-traffic.ts",
    "smoke": "tsx script/smoke.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@pneuma/x402": "workspace:*",
    "dotenv": "^16.4.5",
    "hono": "^4.6.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
